{
  "name": "slotbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:bootstrap": "prisma migrate deploy && npm run seed && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:test:env": "node scripts/setup-test-db-env.mjs",
    "prisma:generate": "prisma generate",
    "seed": "tsx src/lib/seed.ts",
    "test": "vitest run",
    "test:all": "npm test && npm run test:integration && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:integration": "node scripts/run-postgres-tests.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.69.0",
    "luxon": "^3.7.2",
    "next": "16.4.5",
    "prisma": "^5.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
